{
  "expo": {
    "name": "Sudokou",
    "slug": "sudokou",
    "version": "1.2.2",
    "owner": "kirk-baird",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.kirk.sudokou"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#FBF7F0"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.kirk.sudokou"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "2880ebeb-433a-427b-b810-109e98ef4a03"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2880ebeb-433a-427b-b810-109e98ef4a03"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F2EC",
          "dark": {
            "backgroundColor": "#14151C"
          }
        }
      ]
    ]
  }
}
